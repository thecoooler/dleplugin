  "mysql": {
    "install": "CREATE TABLE `{prefix}_example_items` (\n  `id` int NOT NULL AUTO_INCREMENT PRIMARY KEY\n);",
    "upgrade": "ALTER TABLE x;",
    "enable": "INSERT IGNORE INTO `{prefix}_admin_sections` (`name`, `title`, `descr`, `icon`, `allow_groups`) VALUES ('exampleplugin', 'ExamplePlugin', 'Example DLE plugin', '', 'all')",
    "disable": "DELETE FROM `{prefix}_admin_sections` WHERE `name` = 'exampleplugin';",
    "delete": "DELETE FROM `{prefix}_admin_sections` WHERE `name` = 'exampleplugin';"
  },
  "php": {
    "install": "",
    "upgrade": "",
